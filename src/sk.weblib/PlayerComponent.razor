@using sk.shared
@using sk.weblib.Presentation

<div class="hand-container" @ref="handElement" aria-label="Deine Karten" data-inspect-only="@(Inspecting ? "true" : "false")">
    @{
        var cards = GetOrderedCards();
        var legal = validCards;
    }
    @for (var i = 0; i < cards.Count; i++)
    {
        var card = cards[i];
        var playable = !pending && legal.Contains(card);
        var position = i - (cards.Count - 1) / 2.0;
        <div @key="card" class="hand-card" style="@System.FormattableString.Invariant($"--position:{position}")">
            <button type="button" id="@card.GetElementId()" class="skcard @card.GetCssClass() @(playable ? "is-playable" : "")"
                    data-card-id="@GameAction.ToCardId(card)" data-playable="@(playable ? "true" : "false")"
                    aria-label="@CardText.Label(card)" aria-disabled="@(playable || Inspecting ? "false" : "true")" title="@CardText.Label(card)">
            </button>
        </div>
    }
    <div class="touch-selection" hidden>
        <div class="touch-selection-copy" role="status" aria-live="polite" aria-atomic="true">
            <strong class="touch-selection-name"></strong>
            <span class="touch-selection-hint"></span>
        </div>
        <button type="button" class="btn btn-primary touch-play" disabled>Spielen</button>
        <button type="button" class="touch-dismiss" aria-label="Kartenauswahl aufheben">×</button>
    </div>
</div>
@if (error is not null)
{
    <div class="play-error" role="alert">@error</div>
}
