@using Microsoft.JSInterop
@using sk.shared
@using sk.weblib.Presentation
@inject IJSRuntime JSRuntime

<div class="modal" id="startingHandsModal" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true" aria-labelledby="startingHandsTitle" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="startingHandsTitle">Die Starthände</h5>
                <button type="button" class="btn-close" aria-label="Zurück zum Ergebnis" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @foreach (var player in playerViewInfos.OrderBy(p => p.ServerIndex))
                {
                    <h6>@player.TablePlayer.Player.Name</h6>
                    <div class="starting-hand">
                        @foreach (var card in (startingHands.ElementAtOrDefault(player.ServerIndex) ?? []).OrderByDescending(c => c.GetCardOrder(GameType.Ruf, Suit.Herz)))
                        {
                            <div class="skcard @card.GetCssClass()" role="img" aria-label="@CardText.Label(card)" title="@CardText.Label(card)"></div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer"><button class="btn btn-primary" @onclick="Close">Zurück zum Ergebnis</button></div>
        </div>
    </div>
</div>

@code {
    private List<List<Card>> startingHands = [];
    private List<PlayerViewInfo> playerViewInfos = [];
    public void Show(List<List<Card>> cards, List<PlayerViewInfo> players)
    {
        startingHands = cards;
        playerViewInfos = players;
        InvokeAsync(StateHasChanged);
        JSRuntime.InvokeVoidAsync("openModalById", "startingHandsModal");
    }
    private void Close() => JSRuntime.InvokeVoidAsync("openModalById", "gameResultModal");
}
