@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using sk.shared
@inject IJSRuntime JSRuntime

<div class="modal" id="@modalId" aria-hidden="true" aria-labelledby="connectTitle" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="connectTitle">Wie dürfen wir dich nennen?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <div>
                    @if (editContext != null)
                    {
                        <EditForm EditContext="editContext" FormName="ConnectForm">
                            <ValidationSummary />
                            <div>
                                <label for="nameInput" class="form-label">Dein Name am Stammtisch</label>
                                <input class="form-control" id="nameInput" maxlength="32" autocomplete="nickname" aria-describedby="nameHelp"
                                       @bind="model.UserName" @bind:event="oninput" />
                                <div id="nameHelp" class="form-text">Sichtbar für die anderen Spieler.</div>
                                <ValidationMessage For="() => model.UserName" />
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(model.UserName)" @onclick="Save">An den Stammtisch</button>
            </div>
        </div>
    </div>
</div>

@code {
    private string modalId = "connectModal";

    [Parameter]
    public EventCallback<ConnectInfo> OnConnect { get; set; }

    private ConnectInfo model = new();
    EditContext? editContext;

    public void Show(ConnectInfo? seed)
    {
        model = seed is null
            ? new()
            : seed with { }; // record copy

        editContext = new(model);
        JSRuntime.InvokeVoidAsync("openModalById", modalId);
        StateHasChanged();
    }

    public async Task Save()
    {
        if (string.IsNullOrWhiteSpace(model.UserName)) return;
        model = model with { UserName = model.UserName.Trim() };
        await OnConnect.InvokeAsync(model);
        Close();
    }

    public void Close()
    {
        JSRuntime.InvokeVoidAsync("closeModalById", modalId);
    }
}
