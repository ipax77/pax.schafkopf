@using Microsoft.JSInterop
@using sk.shared
@using sk.weblib.Presentation
@inject IJSRuntime JSRuntime

<div class="modal" id="lastTrickModal" aria-hidden="true" aria-labelledby="lastTrickTitle" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div><span class="eyebrow">NOCH EIN BLICK AUFS BLATT</span><h5 class="modal-title" id="lastTrickTitle">Letzter Stich @(number > 0 ? $"· {number}" : "")</h5></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                @if (cards.Any(c => c is not null))
                {
                    <div class="review-table"><TrickLayout Cards="cards" Players="players" PlayOrder="playOrder" Winner="winner" Points="points" /></div>
                }
                else { <p class="empty-trick">Es wurde noch kein Stich gespielt.</p> }
            </div>
        </div>
    </div>
</div>

@code {
    private Card?[] cards = new Card?[4];
    private List<PlayerViewInfo> players = [];
    private int[] playOrder = [];
    private int winner = -1, points, number;
    public void Show(PublicGameState state, List<PlayerViewInfo> playersByView)
    {
        cards = state.Table.PreviouseTrick?.ToArray() ?? new Card?[4];
        playOrder = TrickPlayback.PreviousPlayOrder(state);
        players = state.PublicGameResult is { Players.Count: 4 } result
            ? playersByView.Select(p => p with { TablePlayer = new TablePlayer
                { Position = p.TablePlayer.Position, Player = result.Players[p.ServerIndex] } }).ToList()
            : playersByView;
        winner = TrickPlayback.FindWinner(state, cards);
        points = cards.OfType<Card>().Sum(c => c.GetValue());
        number = state.Turn;
        InvokeAsync(StateHasChanged);
        JSRuntime.InvokeVoidAsync("openModalById", "lastTrickModal");
    }
}
