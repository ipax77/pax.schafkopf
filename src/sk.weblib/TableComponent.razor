@using sk.shared
@using sk.weblib.Modals

<main class="game-shell">
    <header class="game-toolbar">
        <a class="wordmark" href="/" @onclick="LeaveTable" @onclick:preventDefault="true"><span class="brand-acorn" aria-hidden="true">♧</span> Schafkopf<span class="brand-sub">DIE DIGITALE WIRTSSTUBE</span></a>
        <div class="table-meta"><span>Tisch <strong>@publicGameState.ShortCode</strong></span><span class="round-chip">@(publicGameState.RoundNumber > 0 ? $"Runde {publicGameState.RoundNumber}" : "Willkommen")</span></div>
        <div class="toolbar-actions">
            <button class="btn btn-table" id="screentoggle" title="Display eingeschaltet lassen" aria-label="Display anlassen" aria-pressed="false"><i class="bi bi-brightness-high" aria-hidden="true"></i><span>Display anlassen</span></button>
            <button class="btn btn-table" aria-label="Letzter Stich" disabled="@(publicGameState.Table.PreviouseTrick is null)" @onclick="() => lastTrickModal?.Show(publicGameState, playersByView)"><i class="bi bi-stack" aria-hidden="true"></i><span>Letzter Stich</span></button>
            <button class="btn btn-table leave-button" @onclick="LeaveTable" aria-label="Verlassen" title="Tisch verlassen"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span>Verlassen</span></button>
        </div>
        <div class="game-summary" aria-label="Laufendes Spiel">
            <div class="game-summary-copy">
                <span class="game-contract" title="@ContractLabel">Spiel: <strong>@ContractLabel</strong></span>
                @if (DeclarerName is { } declarer)
                {
                    <span class="contract-declarer" title="@($"Ansage: {declarer}")">Ansage: <strong>@declarer</strong></span>
                }
            </div>
            @if (publicGameState.GameState == GameState.Playing)
            {
                <span class="trick-progress">Stich @Math.Min(publicGameState.Turn + 1, 8) / 8</span>
            }
        </div>
    </header>
    <CascadingValue Value="publicGameState">
        <div class="table-frame">
            <div class="game-table">
                @foreach (var opponent in playersByView.Where(p => p.ViewIndex != 0))
                {
                    <section class="opponent-seat seat-@opponent.ViewIndex" aria-label="@opponent.TablePlayer.Player.Name">
                        <OppPlayerComponent PlayerViewInfo="opponent" />
                    </section>
                }
                <section class="table-center">
                    @if (publicGameState.Table.Players.Any(p => p.Player.Guid == Guid.Empty))
                    {
                        <div class="waiting-panel">
                            <span class="eyebrow">GUTE GESELLSCHAFT. GUTE KARTEN.</span>
                            <h1>Ein Platz ist noch frei.</h1>
                            <p>Lade deine Freunde ein oder spiel eine Runde mit unseren Bots.</p>
                            <BotSeatControls State="publicGameState" />
                            <button class="btn btn-table" @onclick="CopyLink"><i class="bi bi-link-45deg" aria-hidden="true"></i> @(linkCopied ? "Einladung kopiert" : "Einladungslink kopieren")</button>
                        </div>
                    }
                    <div class="live-trick @(publicGameState.Table.Players.Any(p => p.Player.Guid == Guid.Empty) ? "d-none" : "")">
                        <TrickComponent @ref="trickComponent" Players="playersByView" OnTrickFinished="TrickFinished" />
                    </div>
                </section>
                <section class="local-seat @(CanAct ? "is-active" : "")" aria-label="Dein Platz">
                    <div class="local-status">
                        <span class="turn-indicator @(CanAct ? "your-turn" : "")" role="status" aria-atomic="true">
                            @if (CanAct) { <i class="bi bi-arrow-up-circle-fill" aria-hidden="true"></i> }
                            @TurnLabel
                        </span>
                        <div class="local-player @(CanAct ? "is-active" : "") @(IsLocalDeclarer ? "is-declarer" : "")">
                            <div class="local-identity">
                                <strong class="local-name" title="@Player.Name">@Player.Name <small>DU</small></strong>
                                @if (IsLocalDeclarer) { <span class="declarer-badge">Ansage</span> }
                            </div>
                            <TrickStack Count="@(playersByView[0].TablePlayer.Tricks.Count / 4)" ViewIndex="0" />
                        </div>
                        @if (publicGameState.GameState == GameState.Finished)
                        {
                            <button class="btn btn-table btn-sm" @onclick="() => gameResultModal?.Show(publicGameState, playersByView)">Ergebnis / Plätze</button>
                        }
                    </div>
                    <PlayerComponent PlayerViewInfo="playersByView[0]" OnCardPlayed="PlayCard" />
                </section>
                <span class="table-signature" aria-hidden="true">A GUADS BLADL!</span>
            </div>
        </div>
    </CascadingValue>
    <footer class="game-footer"><span>Vier Spieler. Ein Stammtisch.</span><span class="mouse-guidance">Klicken oder nach oben ziehen, um zu spielen.</span><span class="touch-guidance">Seitlich wählen · hochziehen und loslassen zum Spielen</span></footer>
</main>
<Bidding1Modal @ref="bidding1Modal" OnWouldPlay="SubmitBidding1" />
<Bidding2Modal @ref="bidding2Modal" OnWouldPlay="SubmitBidding2" />
<LastTrickModal @ref="lastTrickModal" />
<GameResultModal @ref="gameResultModal" OnReady="() => GameHubClient.Ready()" />
