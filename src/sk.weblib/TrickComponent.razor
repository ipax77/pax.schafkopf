@using sk.shared
@using sk.weblib.Presentation
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<TrickLayout Id="live-trick-layout" Cards="cards" Players="Players" PlayOrder="playOrder" Winner="winner" Points="points" />

@code {
    [Parameter] public List<PlayerViewInfo> Players { get; set; } = [];
    [Parameter] public EventCallback<bool> OnTrickFinished { get; set; }

    private readonly TrickPlayback playback = new();
    private readonly Queue<(TrickStep Step, CardOrigin? Origin)> queue = new();
    private Card?[] cards = new Card?[4];
    private List<int> playOrder = [];
    private int winner = -1, points, generation;
    private bool processing, disposed;
    private CancellationTokenSource cancellation = new();
    private TaskCompletionSource? rendered;

    public async Task UpdateAsync(PublicGameState state, Dictionary<string, CardOrigin> origins, bool resync)
    {
        if (disposed) return;
        if (resync || playback.NeedsSync(state))
        {
            generation++;
            cancellation.Cancel();
            cancellation.Dispose();
            cancellation = new();
            rendered?.TrySetCanceled();
            queue.Clear();
            processing = false;
            await JSRuntime.InvokeVoidAsync("skTable.cancelAnimations");
            playback.Sync(state);
            cards = state.Table.CurrentTrick.ToArray();
            playOrder = [.. TrickPlayback.CurrentPlayOrder(state)];
            winner = -1;
            points = 0;
            await InvokeAsync(StateHasChanged);
            await OnTrickFinished.InvokeAsync(true);
            return;
        }
        foreach (var step in playback.Observe(state))
        {
            var key = step.Card is not null && step.Seat == state.YourPosition
                ? $"card-{GameAction.ToCardId(step.Card)}" : $"seat-{step.Seat}";
            queue.Enqueue((step, origins.GetValueOrDefault(key)));
        }
        if (queue.Count > 0 && !processing)
        {
            processing = true;
            await OnTrickFinished.InvokeAsync(false);
            _ = RunAsync(generation, cancellation.Token);
        }
    }

    private async Task RenderAsync(CancellationToken token)
    {
        var completion = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        rendered = completion;
        await InvokeAsync(StateHasChanged);
        await completion.Task.WaitAsync(token);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        rendered?.TrySetResult();
        return Task.CompletedTask;
    }

    private async Task RunAsync(int currentGeneration, CancellationToken token)
    {
        try
        {
            while (queue.TryDequeue(out var item))
            {
                token.ThrowIfCancellationRequested();
                var step = item.Step;
                if (step.Card is not null)
                {
                    // Render the destination slot before measuring it. The card is only placed
                    // there after the overlay reaches it, avoiding a duplicate during flight.
                    await RenderAsync(token);
                    await JSRuntime.InvokeVoidAsync("skTable.flyCard", token,
                        step.Card.GetCssClass(), GameAction.ToCardId(step.Card), step.Seat, item.Origin);
                    token.ThrowIfCancellationRequested();
                    cards[step.Seat] = step.Card;
                    playOrder.Add(step.Seat);
                    await RenderAsync(token);
                }
                else
                {
                    winner = step.Winner ?? -1;
                    points = step.Points;
                    await RenderAsync(token);
                    await JSRuntime.InvokeVoidAsync("skTable.pauseTrick", token);
                    token.ThrowIfCancellationRequested();
                    int view = Players.FirstOrDefault(p => p.ServerIndex == winner)?.ViewIndex ?? -1;
                    await JSRuntime.InvokeVoidAsync("skTable.collectTrick", token, view);
                    token.ThrowIfCancellationRequested();
                    cards = new Card?[4];
                    playOrder.Clear();
                    winner = -1;
                    await RenderAsync(token);
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
        finally
        {
            if (!disposed && currentGeneration == generation)
            {
                processing = false;
                await OnTrickFinished.InvokeAsync(true);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        cancellation.Cancel();
        cancellation.Dispose();
        rendered?.TrySetCanceled();
        queue.Clear();
        try { await JSRuntime.InvokeVoidAsync("skTable.cancelAnimations"); }
        catch (JSDisconnectedException) { }
    }
}
