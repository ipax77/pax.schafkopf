@page "/"
@using sk.pwa.Services
@using sk.shared
@using sk.shared.Interfaces
@using sk.weblib
@using sk.weblib.Modals
@inject ConnectInfoState ConnectState
@inject IGameHubClient GameHubClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Schafkopf · Die digitale Wirtsstube</PageTitle>

@if (GameHubClient.GameState is not null && ConnectState.Current is not null)
{
    <TableComponent Player="CurrentPlayer" OnTableLeft="LeaveTable" />
}
else
{
    <main class="lobby-shell">
        <header class="lobby-header">
            <a class="wordmark" href="/"><span class="brand-acorn" aria-hidden="true">♧</span> Schafkopf<span class="brand-sub">DIE DIGITALE WIRTSSTUBE</span></a>
            <span class="lobby-note">Bayerisches Blatt.<br />Beste Gesellschaft.</span>
        </header>
        <div class="lobby-main">
            <section class="lobby-copy">
                <span class="eyebrow">HEREINSPAZIERT.</span>
                <h1>Ein gutes Blatt.<br /><em>Ein guter Abend.</em></h1>
                <p>Ein Stammtisch ist überall, wo wir zusammenkommen. Spiel Schafkopf mit Freunden oder nimm mit unseren Bots Platz.</p>
                <div class="lobby-features"><span><i class="bi bi-people" aria-hidden="true"></i> Vier am Tisch</span><span><i class="bi bi-suit-club" aria-hidden="true"></i> 32 Karten</span><span><i class="bi bi-heart" aria-hidden="true"></i> Echt bayerisch</span></div>
                <div class="lobby-deck" aria-hidden="true"><div class="skcard card-Ober-Eichel"></div><div class="skcard card-Ace-Herz"></div><div class="skcard card-King-Schellen"></div></div>
            </section>
            <section class="lobby-card" aria-label="Am Tisch Platz nehmen">
                @if (ConnectState.Current is null)
                {
                    <span class="eyebrow">DEIN PLATZ IST NOCH FREI</span>
                    <h2>Servus am Stammtisch.</h2>
                    <p>Alles, was noch fehlt, ist dein Name. Dann kann die erste Runde losgehen.</p>
                    <button class="btn btn-primary mt-3" @onclick="ShowConnect">Platz nehmen <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></button>
                }
                else
                {
                    <span class="eyebrow">SCHÖN, DASS DU DA BIST</span>
                    <h2>Servus, @ConnectState.Current.UserName.</h2>
                    <p>Mach einen neuen Tisch auf oder setz dich zu deinen Freunden.</p>
                    <button class="btn btn-primary mt-2" disabled="@starting" @onclick="CreateGame">Neuen Tisch eröffnen <i class="bi bi-plus-lg ms-2" aria-hidden="true"></i></button>
                    <div class="lobby-divider">ODER DAZUSETZEN</div>
                    @if (!string.IsNullOrWhiteSpace(TableId))
                    {
                        <p>Ein Platz wartet auf dich. Du hast eine Einladung für Tisch <strong>@TableId</strong>.</p>
                        <button class="btn btn-outline-primary" disabled="@starting" @onclick="JoinGame">Einladung annehmen</button>
                    }
                    else
                    {
                        <label class="form-label" for="table-code">Tischcode deiner Freunde</label>
                        <input class="form-control mb-3" id="table-code" placeholder="Tischcode eingeben" autocomplete="off" @bind="_inputTableId" @bind:event="oninput" />
                        <button class="btn btn-outline-primary" disabled="@(starting || string.IsNullOrWhiteSpace(_inputTableId))" @onclick="JoinGameFromInput">An den Tisch setzen</button>
                    }
                }
                @if (starting) { <p class="mt-3 mb-0" role="status">Der Tisch wird vorbereitet …</p> }
                @if (error is not null) { <p class="text-danger mt-3 mb-0" role="alert">@error</p> }
            </section>
        </div>
        <footer class="lobby-footer"><span>Mit Herz gespielt. Mit Freunden geteilt.</span><span>pax.schafkopf</span></footer>
    </main>
}
<ConnectModal @ref="connectModal" OnConnect="Connect" />

@code {
    [SupplyParameterFromQuery] public string? TableId { get; set; }
    private ConnectModal? connectModal;
    private bool starting;
    private string? _inputTableId, error;
    private Player CurrentPlayer => new() { Name = ConnectState.Current?.UserName ?? "Gast", Guid = ConnectState.Current?.Guid ?? Guid.Empty };

    protected override async Task OnInitializedAsync()
    {
        GameHubClient.OnGameInitialized += GameReadyHandler;
        await ConnectState.LoadAsync();
    }
    private void GameReadyHandler() => _ = InvokeAsync(GameReady);
    private async Task Connect(ConnectInfo info)
    {
        await ConnectState.SaveAsync(info);
        await InvokeAsync(StateHasChanged);
    }
    private async Task GameReady()
    {
        if (GameHubClient.GameState is { } state)
            await JSRuntime.InvokeVoidAsync("updateUrlSilently", NavigationManager.GetUriWithQueryParameters(
                new Dictionary<string, object?> { ["TableId"] = state.ShortCode }));
        starting = false;
        StateHasChanged();
    }
    private async Task BeginAsync(Func<Task> action)
    {
        if (starting) return;
        starting = true;
        error = null;
        try
        {
            await action();
            if (GameHubClient.GameState is null) error = "Der Tisch ist gerade nicht erreichbar. Bitte versuche es erneut.";
        }
        catch { error = "Der Tisch konnte nicht geöffnet werden. Prüfe den Tischcode und versuche es erneut."; }
        finally { starting = false; }
    }
    private Task CreateGame() => BeginAsync(() => GameHubClient.StartAsync(CurrentPlayer, Guid.Empty));
    private Task JoinGame() => BeginAsync(() => Guid.TryParse(TableId, out var id)
        ? GameHubClient.StartAsync(CurrentPlayer, id) : GameHubClient.JoinByCode(CurrentPlayer, TableId!.Trim()));
    private Task JoinGameFromInput() => BeginAsync(() => GameHubClient.JoinByCode(CurrentPlayer, _inputTableId!.Trim()));
    private async Task LeaveTable()
    {
        TableId = null;
        await JSRuntime.InvokeVoidAsync("updateUrlSilently", NavigationManager.BaseUri);
        await InvokeAsync(StateHasChanged);
    }
    private void ShowConnect() => connectModal?.Show(new());
    public void Dispose() => GameHubClient.OnGameInitialized -= GameReadyHandler;
}
